<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Shadow Layer / Deep Base -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <gradient
                        android:angle="135"
                        android:startColor="#059669"
                        android:centerColor="#0D9488"
                        android:endColor="#0F766E"
                        android:type="linear" />
                    <stroke
                        android:width="1.5dp"
                        android:color="#B3FFFFFF" />
                </shape>
            </item>
            <!-- Glossy Top Sheen -->
            <item
                android:bottom="18dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="22dp"
                        android:topRightRadius="22dp"
                        android:bottomLeftRadius="8dp"
                        android:bottomRightRadius="8dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#70FFFFFF"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
