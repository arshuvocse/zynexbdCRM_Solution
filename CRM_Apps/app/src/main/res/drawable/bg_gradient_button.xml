<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Gradient Base -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="45"
                        android:startColor="#6366F1"
                        android:centerColor="#4F46E5"
                        android:endColor="#3730A3"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#60FFFFFF" />
                </shape>
            </item>
            <!-- Glossy Top Sheen -->
            <item
                android:bottom="20dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="15dp"
                        android:topRightRadius="15dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#60FFFFFF"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
