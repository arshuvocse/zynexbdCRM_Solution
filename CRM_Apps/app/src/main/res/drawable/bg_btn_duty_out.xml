<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <!-- Red / Coral Gradient Base -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient
                        android:angle="0"
                        android:startColor="#F43F5E"
                        android:centerColor="#EF4444"
                        android:endColor="#DC2626"
                        android:type="linear" />
                    <stroke
                        android:width="1dp"
                        android:color="#40FFFFFF" />
                </shape>
            </item>
            <!-- Glossy Top Sheen -->
            <item
                android:bottom="20dp"
                android:left="1dp"
                android:right="1dp"
                android:top="1dp">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="15dp"
                        android:topRightRadius="15dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#40FFFFFF"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
