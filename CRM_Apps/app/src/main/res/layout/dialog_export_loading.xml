<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ProgressBar
        android:id="@+id/progressExport"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary" />

    <TextView
        android:id="@+id/textExportLoadingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Exporting Report..."
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textExportLoadingMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Generating document and processing images, please wait..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />
</LinearLayout>
