<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="8dp"
    android:paddingHorizontal="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textFollowUpStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_primary"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Interested" />

        <TextView
            android:id="@+id/textFollowUpDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            tools:text="01-Sep-2026 02:30 PM" />

        <TextView
            android:id="@+id/textFollowUpBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="By: Md. Rahim" />
    </LinearLayout>

    <TextView
        android:id="@+id/textFollowUpRemarks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        tools:text="Customer requested a tailored commercial quotation and schedule demo tomorrow." />

    <TextView
        android:id="@+id/textFollowUpNextDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/statusWarning"
        android:textSize="11sp"
        tools:text="Next Scheduled: 03-Sep-2026" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="@color/divider_color" />

</LinearLayout>
