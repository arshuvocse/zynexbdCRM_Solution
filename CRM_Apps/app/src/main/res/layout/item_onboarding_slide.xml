<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Modern Floating Card for Slide Content -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingVertical="26dp">

                <!-- Step Badge Pill -->
                <TextView
                    android:id="@+id/textStepBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_active_pill"
                    android:letterSpacing="0.04"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:text="FEATURE 1 OF 5"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- Glowing Hero Icon Container -->
                <FrameLayout
                    android:id="@+id/containerIconGlow"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card_indigo">

                    <ImageView
                        android:id="@+id/imageSlideIcon"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:contentDescription="Slide Icon"
                        android:src="@drawable/ic_map_custom"
                        app:tint="#FFFFFF" />
                </FrameLayout>

                <!-- Slide Title -->
                <TextView
                    android:id="@+id/textSlideTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:letterSpacing="0.02"
                    android:text="Real-Time GPS Tracking"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Slide Subtitle / Feature Highlights -->
                <TextView
                    android:id="@+id/textSlideDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:text="Accurately records your live field position and coordinates during active shifts."
                    android:textColor="@color/text_secondary"
                    android:textSize="13.5sp" />

                <!-- Status Pill (Active / Action Required) -->
                <LinearLayout
                    android:id="@+id/containerStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_clean_rounded_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp">

                    <TextView
                        android:id="@+id/textActionStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ Ready to use"
                        android:textColor="@color/colorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Slide Action Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonSlideAction"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_gradient_button"
                    android:elevation="4dp"
                    android:letterSpacing="0.03"
                    android:text="CONFIGURE PERMISSION"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
