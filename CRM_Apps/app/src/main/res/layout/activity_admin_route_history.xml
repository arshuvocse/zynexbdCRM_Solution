<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_gradient"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_header_bell_circle"
                android:contentDescription="Menu"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full-Day Travel History"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Realistic GPS Route, Stops &amp; Visits"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Toggle Search Panel Visibility -->
        <ImageButton
            android:id="@+id/buttonToggleSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_glass_input"
            android:contentDescription="Filter"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_search" />
    </LinearLayout>

    <!-- Search Controls Card (Collapsible) -->
    <LinearLayout
        android:id="@+id/cardSearchControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- User Spinner Dropdown -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="Select Employee"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_glass_input"
            android:paddingHorizontal="8dp">

            <Spinner
                android:id="@+id/spinnerUser"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:backgroundTint="@color/text_primary" />
        </FrameLayout>

        <!-- Date Picker Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="3dp"
                    android:text="Select Date"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editDate"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_glass_input"
                    android:focusable="false"
                    android:hint="yyyy-MM-dd"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonSearch"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_gradient_button"
                android:paddingHorizontal="16dp"
                android:text="SEARCH ROUTE"
                android:textColor="@color/text_on_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Map View Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_main_gradient" />

        <!-- Floating Quick Switch Buttons (Top Right of Map) -->
        <LinearLayout
            android:id="@+id/layoutMapFloatingActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonQuickTimeline"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="4dp"
                android:paddingHorizontal="10dp"
                android:text="📜 Timeline"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonQuickReplay"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_glass_card"
                android:elevation="4dp"
                android:paddingHorizontal="10dp"
                android:text="▶ Replay"
                android:textColor="@color/colorAccent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 1. FULL-DAY SUMMARY CARD (Bottom Overlay) -->
        <LinearLayout
            android:id="@+id/cardSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Title & Route Tag -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textRouteTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Route: Md. Rahim"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textRouteModeTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_input"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="🛣️ Road Snapped"
                    android:textColor="@color/colorPrimary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Preserved for backward compatibility -->
            <TextView
                android:id="@+id/textRouteDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Distance: 0.00 km | Start: --:-- | End: --:--"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- Start & End Addresses Row -->
            <LinearLayout
                android:id="@+id/layoutRouteAddresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_input"
                android:orientation="vertical"
                android:padding="6dp">

                <TextView
                    android:id="@+id/textStartAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="🟢 Start: Resolving address..."
                    android:textColor="@color/text_primary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textEndAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="🔴 End: Resolving address..."
                    android:textColor="@color/text_primary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Metrics Chips Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Col 1: Start & End -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_input"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/textStartEndTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🟢 08:42 AM  🔴 05:47 PM"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textVisitsAndGaps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="📍 Visits: 0 | ⚠ Gaps: 0"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <!-- Col 2: Moving vs Stopped -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_input"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/textMovingStoppedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚗 Move: 0h | ⏸ Stop: 0h"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textBatteryAndPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="🔋 Battery: -- | Points: 0"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom Action Row: Timeline & Replay Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonViewTimeline"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_input"
                    android:text="📜 FULL TIMELINE"
                    android:textColor="@color/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonStartReplay"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gradient_button"
                    android:text="▶ PLAY REPLAY"
                    android:textColor="@color/text_on_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. FULL-DAY TIMELINE PANEL (Scrollable Bottom Card) -->
        <LinearLayout
            android:id="@+id/cardTimeline"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">

            <!-- Timeline Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📜 Chronological Travel Timeline"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/buttonCloseTimeline"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_glass_input"
                    android:contentDescription="Close"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color" />

            <!-- Timeline Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTimeline"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- 3. ROUTE REPLAY & TIME SLIDER CARD -->
        <LinearLayout
            android:id="@+id/cardReplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- Replay Header with Status Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textReplayStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="🚗 09:15 AM | Moving 32 km/h"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/buttonCloseReplay"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_glass_input"
                    android:contentDescription="Close Replay"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </LinearLayout>

            <!-- Time Slider (SeekBar) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textReplayStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="08:42 AM"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <SeekBar
                    android:id="@+id/seekBarReplay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="0"
                    android:progressTint="@color/colorPrimary"
                    android:thumbTint="@color/colorPrimary" />

                <TextView
                    android:id="@+id/textReplayEndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="05:47 PM"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Replay Controls Row (Play/Pause & Speed Multiplexers) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/buttonPlayPause"
                    android:layout_width="70dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_gradient_button"
                    android:text="⏸ PAUSE"
                    android:textColor="@color/text_on_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Speed Multiplier Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_input"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/btnSpeed1x"
                        android:layout_width="36dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_gradient_button"
                        android:gravity="center"
                        android:text="1x"
                        android:textColor="@color/text_on_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSpeed2x"
                        android:layout_width="36dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="2x"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSpeed5x"
                        android:layout_width="36dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="5x"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSpeed10x"
                        android:layout_width="36dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:text="10x"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

    </LinearLayout>

    <!-- Left Side Navigation Drawer -->
    <include layout="@layout/layout_admin_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
