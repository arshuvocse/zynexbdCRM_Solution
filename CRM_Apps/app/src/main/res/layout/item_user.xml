<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_user_card"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Top Row: Avatar Circle, User Info, and Phone Contact Chip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Avatar Initials Circle -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_avatar_circle">

            <TextView
                android:id="@+id/textAvatarInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-black"
                android:text="U"
                android:textColor="#4F46E5"
                android:textSize="17sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- User Identity Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textFullName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-bold"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Full Name"
                    android:textColor="#0F172A"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_role_user_pill"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="User"
                    android:textColor="#16A34A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/textUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:text="@username"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Phone / Contact Pill -->
        <TextView
            android:id="@+id/textPhoneNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_action_chip"
            android:drawableStart="@drawable/ic_call_custom"
            android:drawablePadding="6dp"
            android:drawableTint="#2563EB"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Call"
            android:textColor="#2563EB"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:background="#F1F5F9" />

    <!-- Status & Branch Subtitle Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="🟢 Active  •  🏢 Headquarters"
            android:textColor="#475569"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Device Binding Info (Compact & Clean) -->
    <LinearLayout
        android:id="@+id/layoutDeviceInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_device_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/textDeviceBoundInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="🔒 Device: Sony SOG07"
            android:textColor="#0369A1"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/buttonResetDevice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="🔄 Unbind"
            android:textColor="#E11D48"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Operations Row: Customers, Follow-ups, Live Map -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Customers Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonViewCustomers"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_action_chip"
            android:drawableStart="@drawable/ic_people_custom"
            android:drawablePadding="6dp"
            android:drawableTint="#2563EB"
            android:paddingHorizontal="8dp"
            android:text="Customers"
            android:textAllCaps="false"
            android:textColor="#1E40AF"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Follow-ups Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonViewFollowUps"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_action_chip"
            android:drawableStart="@drawable/ic_calendar_custom"
            android:drawablePadding="6dp"
            android:drawableTint="#7C3AED"
            android:paddingHorizontal="8dp"
            android:text="Follow-ups"
            android:textAllCaps="false"
            android:textColor="#5B21B6"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Live Map Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonViewLocation"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="0.9"
            android:background="@drawable/bg_gradient_button"
            android:drawableStart="@drawable/ic_map_custom"
            android:drawablePadding="4dp"
            android:drawableTint="#FFFFFF"
            android:paddingHorizontal="8dp"
            android:text="Live Map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Account Management Controls Row: Reset Password -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Disable / Enable Button (Hidden) -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonToggle"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:visibility="gone" />

        <!-- Reset Password Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonResetPassword"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="@drawable/bg_clean_rounded_card"
            android:drawableStart="@drawable/ic_lock_custom"
            android:drawablePadding="6dp"
            android:drawableTint="#64748B"
            android:paddingHorizontal="12dp"
            android:text="Reset Password"
            android:textAllCaps="false"
            android:textColor="#475569"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
