<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_main_gradient"
        android:orientation="vertical">

        <!-- Top Action Bar with Filter Action -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/buttonBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_header_bell_circle"
                android:contentDescription="Menu"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                app:tint="#FFFFFF" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="Attendance Reports"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Right Side Filter Button -->
        <ImageButton
            android:id="@+id/buttonFilter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_header_bell_circle"
            android:contentDescription="Filter Attendance"
            android:padding="8dp"
            android:src="@drawable/ic_filter_custom"
            app:tint="#FFFFFF" />

    </LinearLayout>

    <!-- Active Filter Subtitle Bar -->
    <LinearLayout
        android:id="@+id/layoutActiveFilterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_clean_rounded_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/textFilterSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📅 August 2026 • All Officers"
            android:textColor="@color/text_primary"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonChangeFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ফিল্টার ▾"
            android:textColor="#4F46E5"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Prominent Export Actions Bar -->
    <LinearLayout
        android:id="@+id/layoutExportBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonMainExportExcel"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_action_chip"
            android:backgroundTint="#10B981"
            android:drawableStart="@drawable/ic_excel_export"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="6dp"
            android:paddingHorizontal="12dp"
            android:text="📊 Export Excel"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonMainExportPdf"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_action_chip"
            android:backgroundTint="#EF4444"
            android:drawableStart="@drawable/ic_pdf_export"
            android:drawableTint="#FFFFFF"
            android:drawablePadding="6dp"
            android:paddingHorizontal="12dp"
            android:text="📑 Export PDF"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Day-Wise Date Navigator Bar (Prev Day, Pick Date, Next Day, All) -->
    <LinearLayout
        android:id="@+id/layoutDateNavigator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_clean_rounded_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/buttonPrevDay"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_glass_input"
            android:contentDescription="Previous Day"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:id="@+id/buttonPickDate"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginHorizontal="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_input"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_calendar_custom"
                app:tint="#4F46E5" />

            <TextView
                android:id="@+id/textSelectedDateDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Today, 28 Aug 2026 ▾"
                android:textColor="@color/text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/buttonNextDay"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_glass_input"
            android:contentDescription="Next Day"
            android:padding="8dp"
            android:rotation="180"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonAllDates"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_input"
            android:paddingHorizontal="10dp"
            android:text="All Days"
            android:textColor="#4F46E5"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Segmented Toggle: Day-Wise Report vs Monthly Summary -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_input"
        android:orientation="horizontal"
        android:padding="4dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonTabLogs"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gradient_button"
            android:text="📅 Day-Wise Report"
            android:textColor="@color/text_on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buttonTabSummary"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:text="📊 Monthly Summary"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Monthly Summary Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerSummary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="visible" />

        <!-- Detailed Attendance Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAttendance"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="12dp"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_calendar"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/textEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="কোনো রেকর্ড পাওয়া যায়নি"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ফিল্টার পরিবর্তন করে আবার চেষ্টা করুন।"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    </LinearLayout>

    <!-- Left Side Navigation Drawer -->
    <include layout="@layout/layout_admin_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
