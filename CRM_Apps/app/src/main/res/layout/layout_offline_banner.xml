<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutNetworkBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_offline_pill"
    android:clickable="false"
    android:elevation="100dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="18dp"
    android:paddingVertical="12dp"
    android:translationZ="100dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/imageNetworkStatusIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_wifi_off"
        app:tint="#FFFFFF" />

    <TextView
        android:id="@+id/textNetworkStatusMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ইন্টারনেট সংযোগ নেই • অফলাইন মোড"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressNetworkReconnecting"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="10dp"
        android:indeterminate="true"
        android:indeterminateTint="#FFFFFF" />

</LinearLayout>
